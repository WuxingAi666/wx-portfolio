# Private /etc/wx-rag/backend.env; chmod 600. Do not commit the filled file.
ENVIRONMENT=production
DEEPSEEK_API_KEY=replace-on-server
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-flash
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_API_KEY=replace-on-server
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_MODEL=BAAI/bge-m3
PUBLIC_SITE_URL=https://llywjr.love/wx/
ALLOWED_ORIGINS=["https://llywjr.love"]
ALLOWED_HOSTS=["llywjr.love","127.0.0.1","localhost"]
STORAGE_DIR=/var/lib/wx-rag
ADMIN_TOKEN=replace-with-random-32-plus-characters
RATE_LIMIT_SALT=replace-with-another-random-32-plus-characters
REQUESTS_PER_MINUTE=6
REQUESTS_PER_IP_DAY=60
REQUESTS_PER_DAY=300
MAX_CONCURRENT=2
