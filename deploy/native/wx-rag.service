[Unit]
Description=WX portfolio RAG API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=wxrag
Group=wxrag
WorkingDirectory=/opt/wx-portfolio/current/backend
EnvironmentFile=/etc/wx-rag/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=HOME=/var/lib/wx-rag
ExecStart=/opt/wx-portfolio/current/.venv/bin/uvicorn app.api:create_app --factory --host 127.0.0.1 --port 3001 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wx-rag
UMask=0027

[Install]
WantedBy=multi-user.target
